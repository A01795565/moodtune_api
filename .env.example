# Variables de entorno para MoodTune API
# Copia este archivo a .env y ajusta los valores segun tu entorno.

# -------------------------------------------------------------------------------------
# App
PROJECT_NAME=moodtune
DEBUG=false
# CORS_ORIGINS puede ser una lista separada por comas o '*'
CORS_ORIGINS=*

# Rutas/cliente opcional
#CLIENT_PATH=./data/Databases/comments/
#DEFAULT_HEADER={"User-Agent":"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.114 Safari/537.36"}

# -------------------------------------------------------------------------------------
# API (Docker)
API_CONTAINER_NAME=moodtune_api
API_PORT=8000
API_PORT_HOST=8000

# Impedir borrar logs de auditoria en prod (false por defecto)
ALLOW_AUDIT_DELETE=false

# -------------------------------------------------------------------------------------
# Base de datos (MySQL 8)
DB_CONTAINER_NAME=moodtune_db
DB_ROOT_PASSWORD=change_me_root
DB_NAME=moodtune
DB_USER=moodTuneTest
DB_PASSWORD=change_me_app

# Si corres con Docker, el host de la app hacia MySQL es 'db'.
# En local sin Docker, usa 'localhost'.
DB_HOST=localhost
DB_PORT=3306          # puerto interno del contenedor
DB_PORT_HOST=3310     # puerto expuesto en tu host

# Pool de conexiones (opcional)
DB_POOL_NAME=moodtune_pool
DB_POOL_SIZE=5

# -------------------------------------------------------------------------------------
# OAuth2 del gateway (opcional)
#TOKEN_URL=
#CLIENT_ID=
#CLIENT_SECRET=
#SCOPE=
#GATEWAY_HEADER_NAME=
#GATEWAY_HEADER_VALUE=

